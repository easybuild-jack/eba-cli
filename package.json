{
  "name": "easybuild-admin",
  "version": "1.1.1",
  "description": "CLI tool to scaffold EasyBuild Admin (易构) projects from a remote template",
  "type": "module",
  "bin": {
    "easybuild-admin": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --clean",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test test/helpers.test.ts",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "keywords": [
    "cli",
    "scaffold",
    "nextjs",
    "easybuild",
    "admin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/easybuild-jack/eba-cli.git"
  },
  "homepage": "https://github.com/easybuild-jack/eba-cli#readme",
  "bugs": {
    "url": "https://github.com/easybuild-jack/eba-cli/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "degit": "^2.8.4",
    "inquirer": "^9.3.0",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/degit": "^2.8.6",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.14.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "tsup": "^8.1.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.74.0"
  }
}
